{
  "name": "ekwi-tech/composer-attribute-collector",
  "type": "composer-plugin",
  "description": "A convenient and near zero-cost way to retrieve targets of PHP 8 attributes (ekwi fork of olvlvl/composer-attribute-collector)",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/ekwi-tech/composer-attribute-collector",
  "authors": [
    {
      "name": "Olivier Laviale",
      "email": "olivier.laviale@gmail.com",
      "homepage": "https://olvlvl.com/",
      "role": "Original author"
    },
    {
      "name": "ekwi",
      "homepage": "https://github.com/ekwi-tech",
      "role": "Fork maintainer"
    }
  ],
  "support": {
    "issues": "https://github.com/ekwi-tech/composer-attribute-collector/issues",
    "source": "https://github.com/ekwi-tech/composer-attribute-collector"
  },
  "autoload": {
    "psr-4": {
      "olvlvl\\ComposerAttributeCollector\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "tests\\olvlvl\\ComposerAttributeCollector\\": "tests",
      "Acme\\": "tests/Acme",
      "Acme81\\": "tests/Acme81"
    },
    "classmap": [
      "tests/Acme/ClassMap"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "require": {
    "php": ">=8.4",
    "composer-plugin-api": ">=2.3",
    "composer/class-map-generator": "^1.4"
  },
  "require-dev": {
    "composer/composer": ">=2.3",
    "phpstan/phpstan": "^2.1.17",
    "phpunit/phpunit": "^9.6.23"
  },
  "replace": {
    "olvlvl/composer-attribute-collector": "self.version"
  },
  "extra": {
    "class": "olvlvl\\ComposerAttributeCollector\\Plugin",
    "composer-attribute-collector": {
      "include": [
        "tests"
      ],
      "exclude": [
        "tests/Acme/PSR4/IncompatibleSignature.php"
      ]
    }
  }
}
